# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Git internals
.git/

# MLflow runtime (large, DVC doesn't need to track)
mlflow.db
mlruns/
mlartifacts/

# Notebook scratch
*.nbconvert.ipynb

# Logs and temporary files
logs/
*.log
tempCodeRunnerFile.py

# Test coverage
.coverage
htmlcov/
coverage.xml

# Reports figures (regenerated by evaluation; DVC doesn't need to re-hash)
reports/figures/

# Raw dataset archives (they're tracked via .dvc pointer, not directly by DVC)
# Note: DVC SHOULD see the metal_nut.tar.xz to compute its hash — do NOT ignore it here.